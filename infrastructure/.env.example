# ==============================================================================
# SynapseX Infrastructure - Environment Variables
# Used by docker-compose.yml for port bindings, credentials, and shared config.
# Copy this file to .env and customize as needed.
# ==============================================================================

# --- Host Port Mappings ---
CLIENT_PORT=3000
API_PORT=3001
AI_SERVICE_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=synapsex_admin_password
MONGO_APP_USER=synapsex_user
MONGO_APP_PASSWORD=synapsex_password

# --- Redis ---
# Leave empty for local dev (no auth). Set a password for staging/production.
REDIS_PASSWORD=

# --- Neo4j Graph Database ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapsex_neo4j_password

# --- MinIO Object Storage ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- JWT Authentication ---
JWT_SECRET=dev-insecure-jwt-secret-for-local-testing-only
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=dev-insecure-refresh-secret-for-local-testing-only
JWT_REFRESH_EXPIRATION=7d

# --- Internal Service Communication ---
AI_SERVICE_API_KEY=internal-dev-secret-token

# --- Logging ---
LOG_LEVEL=debug

# --- AI Model Provider Keys (Optional — services boot without them) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PRIMARY_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
