# ==============================================================================
# SynapseX AI Service (FastAPI + LangGraph) - Environment Variables Template
# ==============================================================================

# Application Configuration
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Internal Service-to-Service Security Token (matches AI_SERVICE_API_KEY in API)
API_SECRET_KEY=your-internal-service-secret-key

# Neo4j Graph Database (Knowledge Graph & Entity Relationships)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapsex_neo4j_password

# MongoDB Read Access (for retrieving case context and evidence metadata)
MONGODB_URI=mongodb://synapsex_user:synapsex_password@localhost:27017/synapsex?authSource=admin
MONGODB_DATABASE=synapsex

# Redis (for LangGraph state checkpointing and memory cache)
REDIS_URL=redis://localhost:6379/0

# LLM Providers & Agent Models (Use placeholder tokens - DO NOT commit real API keys)
OPENAI_API_KEY=your-openai-api-key-placeholder
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder
PRIMARY_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
