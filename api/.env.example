# ==============================================================================
# SynapseX API (NestJS) - Environment Variables Template
# ==============================================================================

# Application Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=debug

# MongoDB Configuration
MONGODB_URI=mongodb://synapsex_user:synapsex_password@localhost:27017/synapsex?authSource=admin

# Redis Configuration (BullMQ & Socket.IO Redis Adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage Configuration (MinIO / S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_EVIDENCE=synapsex-evidence
MINIO_BUCKET_REPORTS=synapsex-reports

# AI Service (FastAPI Microservice) Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-internal-service-secret-key

# JWT & Authentication Security (Placeholder secrets - DO NOT use in production)
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d
