# ==============================================================================
# SynapseX Monorepo - Global Environment Variables Template
# ==============================================================================

# ==========================================
# 1. CLIENT CONFIGURATION (client/.env)
# ==========================================
VITE_API_BASE_URL=http://localhost:3001/api
VITE_WS_BASE_URL=http://localhost:3001

# ==========================================
# 2. MAIN API CONFIGURATION (api/.env)
# ==========================================
API_PORT=3001
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=debug

# MongoDB Connection
MONGODB_URI=mongodb://synapsex_user:synapsex_password@localhost:27017/synapsex?authSource=admin

# Redis Configuration (BullMQ & Socket.IO)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_EVIDENCE=synapsex-evidence
MINIO_BUCKET_REPORTS=synapsex-reports

# Inter-Service Communication
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-internal-service-secret-key

# JWT Secrets (Placeholder values)
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# 3. AI SERVICE CONFIGURATION (ai-service/.env)
# ==========================================
AI_PORT=8000
APP_ENV=development

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=synapsex_neo4j_password
NEO4J_DATABASE=neo4j

# LLM Agent Providers (Placeholder tokens)
OPENAI_API_KEY=your-openai-api-key-placeholder
ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder
PRIMARY_LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini

# ==========================================
# 4. INFRASTRUCTURE & DOCKER PORTS
# ==========================================
CLIENT_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
